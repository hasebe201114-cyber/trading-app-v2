  "bug_prevention_checklist_obs000030": {
    "note": "OBS000030 Stage 0 had 3 paging bugs. This Stage 0 implements fixes:",
    "item_1": {
      "bug": "Termination on 'candles.length < limit' caused premature break",
      "fix": "Use empty response (candles.length === 0) as sole termination"
    },
    "item_2": {
      "bug": "Mistook candles[length-1] as oldest in ascending-order data",
      "fix": "Use candles[0] and verify with actual response order"
    },
