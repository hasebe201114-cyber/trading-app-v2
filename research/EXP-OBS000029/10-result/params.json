      "option_b": "max_dd_reduction >= 5pt AND sharpe_deterioration <= -0.05",
      "logic": "OR",
      "note": "either (a) or (b) required"
    }
  },
  "adoption_criteria": "G1 AND G2 AND G3 AND G4 全て確認期間で満たす必要",
  "halt_if_g1_fail": true,
