  "signal_definition": {
    "ratio": "ETH.close / BTC.close",
    "momentum": "pctChange(ratio[t-L], ratio[t])",
    "threshold": 0.0005,
    "signal_positive": "momRatio > +0.0005 → ETH long / BTC short",
    "signal_negative": "momRatio < -0.0005 → ETH short / BTC long",
    "signal_neutral": "帯内 → no position"
  },
  "execution": {
    "horizon_days": 10,
    "rebalance_frequency": "non-overlapping (10-day hold)",
    "notion": "equal_dollar_notional",
    "neutral_type": "dollar_neutral",
    "note": "beta_neutral版は未実装（本実験では採用しない）"
  },
  "costs": {
    "funding": {
      "enabled": true,
      "btc_file": "btc-funding-2019-2026.csv",
      "eth_file": "eth-funding-2019-2026.csv",
      "aggregation": "daily_sum_of_8h_events",
      "btc_history_start": "2019-09-19",
      "eth_history_start": "2019-09-19",
      "convention": "positive=long_pays_short",
      "long_leg_pnl": "-(fundingRate)",
      "short_leg_pnl": "+(fundingRate)"
    },
    "execution_cost": {
      "one_way_cost": "DEFAULT_EXECUTION_COST.takerFeeRate + slippageRate",
