# Firebase Web SDK config (Vite 経由でブラウザに埋め込まれる公開値)
# このファイルはコミットしてOK。実値は .env.local に書いて使う (.gitignore で除外済)。
# Firebase Console (https://console.firebase.google.com/) で本プロジェクト用の
# プロジェクトを作成し、プロジェクト設定 > マイアプリ > Web アプリ から値を取得。
#
# 既にハードコードされていた reference (旧 firebase.ts からの値):
#   projectId / authDomain は下記に合わせる:
#     VITE_FIREBASE_PROJECT_ID=trading-app-v2-94de8
#     VITE_FIREBASE_AUTH_DOMAIN=trading-app-v2-94de8.firebaseapp.com
#
# apiKey は Firebase Console で再発行 or 既存値を確認の上、.env.local に書く。
# セキュリティ向上のため、Google Cloud Console (APIs & Services > Credentials) で
# 本キーに HTTP referrer 制限を付けることを推奨:
#   https://trading-app-v2-94de8.firebaseapp.com/*
#   http://localhost:5173/*  (ローカル開発用)

VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_PROJECT_ID=trading-app-v2-94de8
VITE_FIREBASE_AUTH_DOMAIN=trading-app-v2-94de8.firebaseapp.com
